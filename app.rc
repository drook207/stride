// app.rc
#include <windows.h>

IDI_ICON1               ICON    DISCARDABLE     "app-icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName", "YourCompany\0"
			VALUE "FileDescription", "Redmine Time Tracker\0"
			VALUE "FileVersion", "1.0.0.0\0"
			VALUE "InternalName", "RedmineTimeTracker\0"
			VALUE "LegalCopyright", "Copyright © 2025\0"
			VALUE "OriginalFilename", "RedmineTimeTracker.exe\0"
			VALUE "ProductName", "Redmine Time Tracker\0"
			VALUE "ProductVersion", "1.0.0.0\0"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
